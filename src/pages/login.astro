---
export const prerender = false;
import Base from "../layouts/Base.astro";
import { createSupabase, getSupabaseConfig, DEFAULT_NEXT, safeNext } from "../lib/supabase";

const next = safeNext(Astro.url.searchParams.get("next"));

const supabase = createSupabase(Astro);
if (supabase) {
  const { data } = await supabase.auth.getUser();
  if (data.user) return Astro.redirect(next);
}

const { configured } = getSupabaseConfig();
const sent = Astro.url.searchParams.get("enviado") === "1";
const error = Astro.url.searchParams.get("error");
const messages: Record<string, string> = {
  email: "Escribe un email válido.",
  envio: "No hemos podido enviar el enlace. Inténtalo de nuevo en un momento.",
  // Supabase ha rechazado la petición por límite de envíos (429) y no ha
  // salido ningún correo nuevo. Puede que el de una petición anterior sí haya
  // llegado: se pide revisarlo y esperar, no reintentar (ver
  // src/pages/api/auth/login.ts).
  espera:
    "Ahora mismo no podemos enviar otro enlace: se han pedido demasiados en muy poco tiempo. Si ya te ha llegado uno, ábrelo en el navegador desde el que lo pediste (mira también en la carpeta de spam). Si no, espera unos minutos antes de volver a pedirlo.",
  // Un enlace vale una sola vez (Supabase lo gasta al abrirlo, en cualquier
  // navegador) y solo en el navegador que lo pidió (PKCE: ver
  // src/pages/api/auth/callback.ts). Reabrir el mismo enlace nunca funciona:
  // la única salida es pedir otro y abrirlo en el navegador desde el que se pide.
  enlace:
    "Este enlace ya no sirve: cada enlace vale una sola vez y solo en el navegador desde el que se pidió. Pide uno nuevo aquí abajo y ábrelo en este mismo navegador. Si tu app de correo abre los enlaces dentro de la app, pídelo desde Safari o Chrome y, en el correo, mantén pulsado el enlace para abrirlo allí.",
  config: "El acceso todavía no está activado.",
};
---
<Base title="Acceder">
  <section class="wrap page narrow">
    <h1>Acceder</h1>
    <p class="lede">Te enviamos un enlace a tu email. Sin contraseñas.</p>

    {sent && (
      <p class="notice">Enlace enviado. Revisa tu bandeja de entrada (y la carpeta de spam).</p>
    )}
    {error && <p class="notice error">{messages[error] ?? "Ha ocurrido un error."}</p>}

    {configured ? (
      <form class="stack" method="post" action="/api/auth/login">
        {next !== DEFAULT_NEXT && <input type="hidden" name="next" value={next} />}
        <label for="email">Email</label>
        <input id="email" name="email" type="email" required autocomplete="email" placeholder="tu@email.com" />
        <button class="button" type="submit">Enviarme el enlace</button>
      </form>
    ) : (
      <p class="notice">La zona privada estará disponible muy pronto.</p>
    )}
  </section>
</Base>
