---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import Base from "../../layouts/Base.astro";

const description = "Historias del arte contadas como un chisme. Cuadros que no existen, artistas que sí.";
const historias = (await getCollection("historias")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---
<Base title="Historias" description={description}>
  <section class="wrap page" aria-labelledby="historias-title">
    <div class="head">
      <span class="sticker tag">Historias</span>
      <h1 id="historias-title">La cara B, por escrito</h1>
      <p class="lede">{description}</p>
    </div>

    <ul class="grid">
      {historias.map((h, i) => (
        <li class="item" style={`--tilt: ${i % 2 === 0 ? -1.2 : 1.2}deg`}>
          <a class="story-card" href={`/historias/${h.id}/`}>
            <Picture
              src={h.data.cover}
              widths={[320, 480, 640]}
              sizes="(min-width: 721px) 20rem, 45vw"
              formats={["avif", "webp"]}
              fallbackFormat="jpg"
              alt=""
              loading="lazy"
              class="story-img"
              pictureAttributes={{ class: "story-pic" }}
            />
            <span class="story-meta">
              <span class="sticker story-tag">{h.data.tag}</span>
              <h2 class="story-title">{h.data.title}</h2>
              <span class="story-desc">{h.data.description}</span>
              <span class="story-read">
                Leer
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .head { display: flex; flex-direction: column; align-items: flex-start; margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .head h1 { margin-top: 1rem; }
  .head .lede { margin: 0; }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    max-width: 62rem;
  }
  .item { transform: rotate(var(--tilt)); transition: transform 0.2s ease; }
  .item:hover, .item:focus-within { transform: rotate(0deg) translateY(-4px); }

  .story-card {
    position: relative;
    display: block;
    aspect-ratio: 9 / 16;
    border-radius: 1.4rem;
    overflow: hidden;
    background: var(--lavender);
    box-shadow: 0 10px 0 rgba(36, 31, 28, 0.08);
    text-decoration: none;
    color: #fff;
  }
  .story-card:hover { color: #fff; }
  .story-card:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
  .story-card :global(.story-pic), .story-card :global(.story-img) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .story-card :global(.story-img) { object-fit: cover; transition: transform 0.35s ease; }
  .story-card:hover :global(.story-img) { transform: scale(1.04); }

  .story-meta {
    position: absolute; left: 0; right: 0; bottom: 0;
    padding: 5rem 0.9rem 0.9rem;
    display: flex; flex-direction: column; gap: 0.35rem; align-items: flex-start;
    background: linear-gradient(180deg, rgba(36, 31, 28, 0) 0%, rgba(36, 31, 28, 0.6) 35%, rgba(36, 31, 28, 0.92) 100%);
  }
  .story-tag {
    font-size: 0.62rem; letter-spacing: 0.12em; text-transform: uppercase;
    background: var(--butter); color: #5a4300;
    padding: 0.3rem 0.5rem; border-radius: 4px; transform: rotate(-2deg);
  }
  .story-title {
    font-size: 1.05rem; line-height: 1.1; letter-spacing: -0.01em; margin: 0.15rem 0 0;
    color: #fff; text-shadow: 0 1px 8px rgba(0, 0, 0, 0.35); text-wrap: balance;
  }
  .story-desc {
    font-size: 0.8rem; line-height: 1.35; color: rgba(251, 246, 238, 0.9);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .story-read {
    display: inline-flex; align-items: center; gap: 0.35rem;
    margin-top: 0.25rem; font-weight: 700; font-size: 0.85rem; color: var(--butter);
  }
  .story-read svg { transition: transform 0.15s ease; }
  .story-card:hover .story-read svg { transform: translateX(4px); }

  @media (max-width: 420px) {
    .story-desc { display: none; }
    .story-meta { padding-top: 3.6rem; }
  }
  @media (min-width: 721px) {
    .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
    .story-meta { padding: 6rem 1.1rem 1.1rem; gap: 0.45rem; }
    .story-title { font-size: 1.25rem; }
    .story-desc { font-size: 0.88rem; -webkit-line-clamp: 3; }
  }
</style>
