---
import { Font, getImage } from "astro:assets";
import heroWide from "../assets/hero-wide.jpg";
import SocialIcon from "../components/SocialIcon.astro";
import { TIKTOK_PROFILE, INSTAGRAM_PROFILE } from "../lib/social";

interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata;
  type?: "website" | "article";
}
const {
  title,
  description = "Núria Sánchez, ilustradora. La cara B de la historia del arte, contada en rosa pastel.",
  image = heroWide,
  type = "website",
} = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
// La página 404 se sirve en cualquier URL que no existe: sin canonical ni og:url
// (apuntarían a /404/, que no existe) y fuera del índice.
const isNotFound = /^\/404\/?$/.test(path);
// Imagen para redes: jpg de hasta 1200 px (el servicio no amplía originales más pequeños).
const og = await getImage({ src: image, width: Math.min(1200, image.width), format: "jpg" });
const ogImage = new URL(og.src, Astro.site);
// Las páginas estáticas se publican con barra final (/historias/, /sobre/...), la
// misma forma que usan canonical, og:url y el sitemap: los enlaces internos a ellas
// la llevan también. /cuenta y /login son rutas bajo demanda y van sin barra.
const nav = [
  { href: "/", label: "Inicio" },
  { href: "/historias/", label: "Historias" },
  { href: "/sobre/", label: "Sobre Núria" },
  { href: "/contacto/", label: "Contacto" },
];
const isHome = path === "/";
const here = path.endsWith("/") ? path : `${path}/`;
// "page" solo en el enlace a la página actual; "true" en el de la sección que la
// contiene (Historias, dentro de /historias/<slug>/).
const ariaCurrent = (href: string) =>
  here === href ? "page" : href !== "/" && here.startsWith(href) ? "true" : undefined;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={`${title} · Núria Sánchez`} />
    <meta property="og:description" content={description} />
    {isNotFound ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        <meta property="og:url" content={canonical} />
      </>
    )}
    <meta property="og:type" content={type} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={og.attributes.width} />
    <meta property="og:image:height" content={og.attributes.height} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · Núria Sánchez`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#fbf6ee" />
    <title>{title} · Núria Sánchez</title>
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-sticker" />
  </head>
  <body>
    <header class:list={["site-header", { "over-hero": isHome }]}>
      <a class="brand" href="/">Núria Sánchez</a>
      <nav aria-label="Principal">
        {nav.map((item) => (
          <a href={item.href} aria-current={ariaCurrent(item.href)}>{item.label}</a>
        ))}
      </nav>
      <a class="pill" href="/cuenta">Acceder</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Núria Sánchez</span>
      <nav aria-label="Pie">
        <a href="/historias/">Historias</a>
        <a href="/sobre/">Sobre Núria</a>
        <a href="/contacto/">Contacto</a>
        <a href="/cuenta">Acceder</a>
      </nav>
      <nav class="social" aria-label="Redes">
        <a href={TIKTOK_PROFILE} target="_blank" rel="noopener"><SocialIcon name="tiktok" size={16} /> TikTok</a>
        <a href={INSTAGRAM_PROFILE} target="_blank" rel="noopener"><SocialIcon name="instagram" size={16} /> Instagram</a>
      </nav>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --cream: #fbf6ee;
    --ink: #241f1c;
    --body: #4f4640;
    --muted: #6e655e;
    --line: #e9dccb;
    --pink: #f5a9c8;
    --mint: #bfe8d6;
    --butter: #f8e3a1;
    --lavender: #d9d2f4;
    /* Anillo de foco: tinta, 15:1 sobre crema (el rosa no llega a 2:1). */
    --focus: var(--ink);
    --max: 82rem;
    --gutter: clamp(1.25rem, 4.5vw, 4rem);
  }
  * { box-sizing: border-box; }
  html { color-scheme: light; scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--cream);
    color: var(--ink);
    font-family: var(--font-body);
    line-height: 1.55;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    -webkit-font-smoothing: antialiased;
  }
  h1, h2, h3 {
    font-family: var(--font-display);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin: 0 0 0.5em;
    text-wrap: balance;
  }
  h1 { font-size: clamp(2.6rem, 6vw, 4.5rem); }
  h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); }
  p { margin: 0 0 1em; text-wrap: pretty; }
  a { color: var(--ink); }
  a:hover { color: #b4577e; }
  main { flex: 1; }
  .wrap { width: min(100% - 2 * var(--gutter), var(--max)); margin-inline: auto; }

  /* Escritorio: una fila (marca | enlaces · Acceder). Hasta 720 px: dos filas,
     marca y Acceder arriba y los enlaces debajo (ver la media query del final). */
  .site-header {
    width: min(100% - 2 * var(--gutter), var(--max));
    margin-inline: auto;
    padding: 1.4rem 0;
    display: flex;
    align-items: center;
    column-gap: clamp(0.9rem, 2.4vw, 2rem);
    row-gap: 1rem;
    flex-wrap: wrap;
    position: relative;
    z-index: 3;
  }
  /* En escritorio la cabecera (una fila) flota entera sobre la foto de portada. */
  .site-header.over-hero { margin-bottom: -5.5rem; }
  .brand { font-family: var(--font-display); font-weight: 800; font-size: 1.35rem; letter-spacing: -0.02em; text-decoration: none; color: var(--ink); }
  .site-header nav { margin-left: auto; display: flex; gap: clamp(0.9rem, 2.4vw, 2rem); align-items: center; flex-wrap: wrap; }
  .site-header nav a { font-weight: 500; font-size: 0.95rem; text-decoration: none; color: var(--ink); }
  .site-header nav a[aria-current] { text-decoration: underline; text-underline-offset: 0.35em; text-decoration-thickness: 2px; text-decoration-color: var(--pink); }
  .pill {
    font-weight: 700;
    font-size: 0.95rem;
    background: var(--ink);
    color: var(--cream);
    padding: 0.7rem 1.35rem;
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .pill:hover { color: var(--cream); background: #3a322d; transform: translateY(-1px); }

  .sticker {
    display: inline-block;
    font-family: var(--font-sticker);
    font-weight: 900;
    letter-spacing: 0.02em;
  }
  .tag {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    background: var(--mint);
    color: #1e4d3b;
    transform: rotate(-2deg);
  }
  .button {
    display: inline-block;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1rem;
    color: var(--ink);
    background: var(--pink);
    padding: 0.95rem 1.7rem;
    border-radius: 999px;
    border: 0;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 6px 0 rgba(36, 31, 28, 0.12);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    /* Nunca más ancho que su contenedor: un texto largo sin espacios (el email de
       /contacto/ a 320 px) parte línea en vez de desbordar la página. */
    max-width: 100%;
    overflow-wrap: anywhere;
  }
  .button:hover { color: var(--ink); transform: translateY(-2px); box-shadow: 0 8px 0 rgba(36, 31, 28, 0.14); }
  .button:active { transform: translateY(2px); box-shadow: 0 3px 0 rgba(36, 31, 28, 0.14); }
  .button.secondary { background: transparent; border: 2px solid var(--ink); box-shadow: none; padding: calc(0.95rem - 2px) calc(1.7rem - 2px); }
  .button.secondary:hover { box-shadow: none; }
  .button.dark { background: var(--ink); color: var(--cream); box-shadow: none; }
  .button.dark:hover { color: var(--cream); box-shadow: none; }

  .card {
    position: relative;
    border-radius: 1.75rem;
    padding: 2.6rem 2.4rem 2.2rem;
    background: #fff;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    align-items: flex-start;
  }
  .card > .label {
    position: absolute;
    top: -0.85rem;
    left: 1.6rem;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    background: var(--ink);
    color: var(--cream);
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    transform: rotate(-3deg);
  }
  .card p { color: var(--body); max-width: 28rem; }
  .card.lavender { background: var(--lavender); }
  .card.mint { background: var(--mint); }
  .card.butter { background: var(--butter); }

  .page { padding: clamp(3rem, 8vw, 6rem) 0; }
  .lede { font-size: clamp(1.1rem, 1.6vw, 1.35rem); color: var(--body); max-width: 36rem; }
  .narrow { max-width: 38rem; }
  .dots {
    background-image: radial-gradient(var(--line) 1.2px, transparent 1.2px);
    background-size: 22px 22px;
  }
  form.stack { display: grid; gap: 0.75rem; max-width: 26rem; }
  label { font-weight: 500; }
  input[type="email"], input[type="text"] {
    width: 100%;
    padding: 0.85rem 1rem;
    border: 2px solid var(--line);
    border-radius: 0.9rem;
    font: inherit;
    background: #fff;
  }
  input:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; border-color: var(--ink); }
  .notice { padding: 0.9rem 1rem; border-radius: 1rem; background: var(--butter); color: #5a4300; }
  .notice.error { background: #fdd9e6; color: #7a2648; }

  .site-footer {
    width: min(100% - 2 * var(--gutter), var(--max));
    margin-inline: auto;
    padding: 1.6rem 0 2.2rem;
    border-top: 1.5px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .site-footer nav { display: flex; flex-wrap: wrap; column-gap: 1.4rem; row-gap: 0.5rem; }
  .site-footer a { color: var(--muted); text-decoration: none; white-space: nowrap; }
  .site-footer a:hover { color: var(--ink); }
  .site-footer .social a { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--ink); font-weight: 500; }

  @media (max-width: 720px) {
    /* Fila 1: marca y Acceder. Fila 2: los enlaces, a todo el ancho. */
    .site-header .pill { margin-left: auto; }
    .site-header nav { order: 1; flex-basis: 100%; margin-left: 0; }
    /* La foto de portada empieza entre las dos filas: marca y Acceder quedan sobre
       crema y los enlaces sobre el velo claro de la foto. El solape es lo que queda
       por debajo de esa línea: medio row-gap + la línea de enlaces + el padding. */
    .site-header.over-hero { margin-bottom: calc(-1 * (0.5rem + 0.95rem * 1.55 + 1.4rem)); }
  }
  @media (max-width: 560px) {
    .site-header nav a[href="/"] { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
</style>
