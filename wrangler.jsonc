{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "nuriasanchezromero",
	"compatibility_date": "2026-09-08",
	"compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"routes": [
		{ "pattern": "nuriasanchezromero.com", "custom_domain": true },
		{ "pattern": "www.nuriasanchezromero.com", "custom_domain": true }
	],
	"vars": {
		"PUBLIC_SUPABASE_URL": "",
		"PUBLIC_SUPABASE_ANON_KEY": ""
	},
	"observability": {
		"enabled": true
	}
}
